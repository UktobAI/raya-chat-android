<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Raya Chat Sample"
        android:supportsRtl="true"
        android:theme="@style/Theme.RayaChatSample">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RayaChatSample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ComposeDemoActivity" android:theme="@style/Theme.RayaChatSample" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FragmentDemoActivity" android:theme="@style/Theme.RayaChatSample.AppCompat" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BottomSheetDemoActivity" android:theme="@style/Theme.RayaChatSample.AppCompat" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HeadlessDemoActivity" android:theme="@style/Theme.RayaChatSample" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
